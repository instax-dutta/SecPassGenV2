# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env.local and fill in your values
#
# Nothing here is required for the app to run. Passwords are generated in the
# browser, so there is no server state, no database, and no signing secret.
# The app builds and runs with an entirely empty environment.
# ========================================

# Public site URL, used for canonical URLs and Open Graph tags
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Parent domain, shown in the footer credit
NEXT_PUBLIC_MAIN_DOMAIN=https://sdad.pro