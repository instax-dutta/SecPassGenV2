# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env.local and fill in your values
# ========================================

# Database Connection (NeonDB)
DATABASE_URL=your_neondb_connection_string_here

# Password signature secret - REQUIRED, minimum 32 characters.
# Signs the HMAC stored instead of every generated password. Without it the
# API refuses to record passwords rather than falling back to a known constant,
# because a known constant turns a database dump into a list of your users'
# passwords. Generate one with: openssl rand -base64 48
# Rotating this invalidates every stored signature, so treat it as permanent.
UNIQUENESS_SECRET=

# Pepper for anonymised client-address hashing - optional, minimum 16 characters.
# Defaults to a domain-separated use of UNIQUENESS_SECRET when unset.
IP_PEPPER=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Main Domain
NEXT_PUBLIC_MAIN_DOMAIN=https://sdad.pro

# Rate Limiting (Optional)
RATE_LIMIT_PER_HOUR=100
